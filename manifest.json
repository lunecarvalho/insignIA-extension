{
  "manifest_version": 3,
  "name": "InsignIA",
  "short_name": "InsignIA",
  "version": "1.0.0",
  "description": "InsignIA — Análise Inteligente de Interações (Chrome Extension)",
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["http://localhost:8000/*", "https://api.insignia.local/*"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "InsignIA — Analisar Conversa",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
